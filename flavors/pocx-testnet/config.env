#!/bin/bash
# Bitcoin PoCX Testnet Flavor Configuration
# This flavor matches the design of the Bitcoin PoCX webpage

export SITE_TITLE='Bitcoin PoCX Testnet Explorer'
export HOME_TITLE='Bitcoin PoCX Testnet Explorer'
export SITE_DESC='Bitcoin PoCX Testnet blockchain explorer - Proof of Capacity Extended'

# Asset configuration
export NATIVE_ASSET_LABEL='BTCX'
export NATIVE_ASSET_NAME='Bitcoin PoCX'

# Menu configuration
export MENU_ACTIVE='Bitcoin PoCX Testnet'
export BASE_HREF=${BASE_HREF:-'/testnet/'}

# Custom branding
export SITE_FOOTER='© 2025 Proof of Capacity Consortium. All rights reserved.'
export FOOTER_LINKS='{"img/github_blue.png": "https://github.com/PoC-Consortium/esplora-pocx"}'

# Custom assets and CSS
export CUSTOM_ASSETS="$CUSTOM_ASSETS flavors/pocx-testnet/www/*"
export CUSTOM_CSS="$CUSTOM_CSS flavors/pocx-testnet/extras.css"

# Meta tags for SEO
export HEAD_HTML='<meta name="theme-color" content="#ED7D31">'
